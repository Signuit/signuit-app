# SignUIT Production Environment Variables
# Copy to .env and fill in values before deploying.
# DO NOT commit .env to git.

# ─── Domain ────────────────────────────────────────────────────────────────
DOMAIN=signuit.com
ACME_EMAIL=your@email.com          # For Let's Encrypt SSL notifications

# ─── Auth (Better Auth) ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── Session & Sandbox ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
SANDBOX_SECRET=secret

# ─── Canton ────────────────────────────────────────────────────────────────
# Set internally via docker-compose — do not change unless custom Canton setup
# CANTON_API_URL=http://canton-sandbox:7575
# OPERATOR_PARTY_ID=SignUIT

# ─── Database ──────────────────────────────────────────────────────────────
# Set internally via docker-compose — uses Docker volume
# DATABASE_URL=file:/data/signuit.db

# ─── Node ──────────────────────────────────────────────────────────────────
NODE_ENV=production
