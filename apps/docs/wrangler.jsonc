{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-docs",
	"compatibility_date": "2026-03-25",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"assets": {
		"directory": "dist/client"
	},
	"routes": [
		{
			"pattern": "docs.signuit.com/*",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
