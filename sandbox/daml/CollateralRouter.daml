module CollateralRouter where

-- SignUIT CollateralRouter - Core smart contracts for collateral routing
-- Corrected multi-party architecture: "Operator as infrastructure, not gatekeeper"

-- ─────────────────────────────────────────────────────────────────────────────
-- Data Types
-- ─────────────────────────────────────────────────────────────────────────────

data RuleType 
  = CTD           -- Cheapest-to-Deliver
  | ExpiryFirst   -- Prioritize expiring collateral
  | YieldMax     -- Yield Maximizer
  deriving (Eq, Show)

data RouteStatus 
  = RoutePending 
  | RouteApproved 
  | RouteRejected 
  | RouteExecuted
  | RouteFailed
  deriving (Eq, Show)

data RoutingOption = RoutingOption with
    assets   : [Text]
    amounts  : [Decimal]
    savings  : Decimal
    label    : Text
  deriving (Eq, Show)

data AgreementStatus
  = AgreementPending
  | AgreementActive
  | AgreementTerminated
  deriving (Eq, Show)

data OnboardingStatus
  = OnboardingPending
  | UnderReview
  | OnboardingApproved
  | OnboardingRejected
  deriving (Eq, Show)

-- ─────────────────────────────────────────────────────────────────────────────
-- Helpers
-- ─────────────────────────────────────────────────────────────────────────────

netValue : Decimal -> Decimal -> Decimal
netValue amount haircut = amount * (1.0 - haircut)

canCover : Decimal -> Decimal -> Decimal -> Bool
canCover amount required haircut = 
  netValue amount haircut >= required

-- ─────────────────────────────────────────────────────────────────────────────
-- AssetMetadata - Market data for collateral assets
-- ─────────────────────────────────────────────────────────────────────────────

template CollateralAssetMetadata
  with
    operator    : Party
    assetSymbol  : Text        -- "USDC", "USYC", "UST", "GILT"
    currentYield: Decimal     -- e.g. 0.045 = 4.5%
    haircut     : Decimal     -- e.g. 0.02 = 2%
    eligible    : Bool        -- Can be used as collateral
    updatedAt   : Time
  where
    signatory operator

    choice UpdateMetadata : ContractId CollateralAssetMetadata
      with
        newYield    : Decimal
        newHaircut  : Decimal
        newEligible : Bool
      controller operator
      do
        now <- getTime
        create this with
          currentYield = newYield
          haircut = newHaircut
          eligible = newEligible
          updatedAt = now

-- ─────────────────────────────────────────────────────────────────────────────
-- Onboarding: JoinRequest (Institution applies, Operator accepts)
-- ─────────────────────────────────────────────────────────────────────────────

template JoinRequest
  with
    applicant     : Party   -- Institution applying to join
    operator       : Party   -- SignUIT network operator
    companyName    : Text    -- Legal company name
    companyId      : Text    -- Registration number
    requestedTier  : Text    -- "basic", "standard", "premium"
    contactEmail   : Text    -- Primary contact
    submittedAt   : Time
    status         : OnboardingStatus
  where
    signatory applicant

    -- Operator reviews and accepts → creates ServiceAgreement
    choice AcceptRequest : ContractId ServiceAgreement
      with
        agreementId   : Text
        approvedPolicy : CollateralPolicy
      controller operator
      do
        now <- getTime
        create ServiceAgreement with
          operator = operator
          institution = applicant
          agreementId = agreementId
          policy = approvedPolicy
          tier = requestedTier
          status = AgreementActive
          createdAt = now
          acceptedAt = Some now

    -- Operator rejects the application
    choice RejectRequest : ContractId JoinRequest
      with
        rejectionReason : Text
      controller operator
      do
        create this with status = OnboardingRejected

    -- Operator puts under review
    choice SetUnderReview : ContractId JoinRequest
      controller operator
      do
        create this with status = UnderReview

-- ─────────────────────────────────────────────────────────────────────────────
-- ServiceAgreement - Active network membership
-- ─────────────────────────────────────────────────────────────────────────────

template ServiceAgreement
  with
    operator       : Party        -- SignUIT protocol operator
    institution    : Party        -- Institution party
    agreementId    : Text         -- Unique agreement ID
    policy         : CollateralPolicy  -- Institution's routing policy
    tier           : Text         -- "basic", "standard", "premium"
    status         : AgreementStatus
    createdAt      : Time
    acceptedAt     : Optional Time
  where
    signatory operator, institution

    -- Archive the agreement
    choice TerminateAgreement : ContractId ServiceAgreement
      controller institution
      do
        create this with status = AgreementTerminated

    -- Update policy (institution initiates, both sign)
    choice UpdateServicePolicy : ContractId ServiceAgreement
      with
        newPolicy : CollateralPolicy
      controller operator, institution
      do
        create this with policy = newPolicy

-- ─────────────────────────────────────────────────────────────────────────────
-- CollateralPolicy - Institution's routing rules
-- ─────────────────────────────────────────────────────────────────────────────

template CollateralPolicy
  with
    operator          : Party        -- SignUIT protocol operator
    institution       : Party        -- The institution owning this policy
    policyId          : Text         -- Unique policy identifier
    ruleType          : RuleType     -- CTD, ExpiryFirst, or YieldMax
    priorityList      : [Text]       -- ["USYC", "UST", "USDC"]
    minLtv            : Decimal       -- Minimum LTV (e.g. 0.95)
    maxHaircut        : Decimal       -- Maximum haircut (e.g. 0.10)
    counterpartyRules : [(Text, [Text])] -- Map counterparty -> eligible assets
    autoApprove       : Bool         -- Enable auto-approval (Phase 2)
    notificationEmail : Optional Text -- Alert on suggestions
    active            : Bool         -- Is policy active
    createdAt         : Time
  where
    signatory operator, institution

    ensure 
      not (null priorityList)
      && minLtv > 0.0 && minLtv <= 1.0
      && maxHaircut >= 0.0 && maxHaircut < 1.0

    -- Update policy
    choice UpdateCollateralPolicy : ContractId CollateralPolicy
      with
        newRuleType          : RuleType
        newPriorityList      : [Text]
        newMinLtv            : Decimal
        newMaxHaircut        : Decimal
        newCounterpartyRules : [(Text, [Text])]
        newAutoApprove       : Bool
        newNotificationEmail : Optional Text
        newActive            : Bool
      controller institution
      do
        create this with
          ruleType          = newRuleType
          priorityList      = newPriorityList
          minLtv            = newMinLtv
          maxHaircut        = newMaxHaircut
          counterpartyRules = newCounterpartyRules
          autoApprove       = newAutoApprove
          notificationEmail = newNotificationEmail
          active            = newActive

    -- Archive policy
    choice ArchivePolicy : ()
      controller institution
      do return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- CollateralHolding - On-chain collateral position
-- ─────────────────────────────────────────────────────────────────────────────

template CollateralHolding
  with
    operator   : Party       -- SignUIT operator
    holdingId  : Text        -- Unique holding identifier
    institution: Party      -- Institution owning the holding
    asset      : Text         -- Asset symbol (USDC, USYC, UST, etc)
    amount     : Decimal     -- Available amount
    yield      : Decimal     -- Annual yield (e.g. 0.045 = 4.5%)
    haircut    : Decimal     -- Haircut (e.g. 0.05 = 5%)
    expiry     : Optional Time
  where
    signatory institution
    observer operator  -- Operator can see all holdings (orchestration)

    -- Update holding amount
    choice UpdateHolding : ContractId CollateralHolding
      with
        newAmount : Decimal
      controller institution
      do
        create this with amount = newAmount

-- ─────────────────────────────────────────────────────────────────────────────
-- MarginCall - Incoming margin call
-- ─────────────────────────────────────────────────────────────────────────────

template MarginCall
  with
    callId         : Text        -- Unique call identifier
    operator      : Party       -- SignUIT operator
    institution   : Party       -- Institution receiving call
    counterparty   : Party       -- Calling counterparty
    amountRequired: Decimal     -- Amount needed
    currency      : Text        -- Currency (USD, EUR, etc)
    dueBy         : Time        -- Deadline
    status        : RouteStatus
    createdAt     : Time
  where
    signatory counterparty
    observer institution, operator  -- Both see the call

    -- Mark as satisfied
    choice SatisfyMarginCall : ContractId MarginCall
      controller counterparty
      do
        create this with status = RouteExecuted

-- ─────────────────────────────────────────────────────────────────────────────
-- RoutingSuggestion - Pending routing recommendation
-- ─────────────────────────────────────────────────────────────────────────────

template RoutingSuggestion
  with
    routeId                : Text            -- Unique route identifier
    institution           : Party           -- Institution (decision owner)
    operator              : Party           -- SignUIT operator (observer/orchestrator)
    marginCallId          : Text            -- Associated margin call
    amountRequired        : Decimal         -- Amount needed
    suggestedAssets      : [Text]          -- Asset symbols in priority order
    suggestedAmounts     : [Decimal]       -- Amounts of each asset
    estimatedOpportunityCost : Decimal     -- Opportunity cost in USD
    opportunityCostBps  : Decimal        -- vs USDC baseline
    alternativeOptions   : [RoutingOption] -- Alternative selections
    expiryWarnings      : [Text]         -- Assets expiring soon
    explanation         : Text             -- Human-readable rationale
    status               : RouteStatus
    createdAt            : Time
  where
    signatory institution
    observer operator  -- Operator orchestrates but does NOT gate

    ensure not (null suggestedAssets)
      && length suggestedAssets == length suggestedAmounts

    -- Institution approves the suggestion (SOLE decision)
    choice ApproveSuggestion : ContractId AllocationRecord
      with
        approvedBy : Party
      controller institution
      do
        now <- getTime
        create AllocationRecord with
          operator             = operator
          routeId             = routeId
          institution         = institution
          marginCallId        = marginCallId
          assetsSent         = suggestedAssets
          amountsSent        = suggestedAmounts
          ruleApplied        = "CTD"
          opportunityCostBps = (estimatedOpportunityCost / amountRequired) * 10000.0
          approvedBy        = approvedBy
          executedAt         = now
          status            = RouteExecuted

    -- Institution rejects
    choice RejectSuggestion : ()
      controller institution
      do return ()

-- ─────────────────────────────────────────────────────────────────────────────
-- AllocationRecord - Immutable audit trail
-- ─────────────────────────────────────────────────────────────────────────────

template AllocationRecord
  with
    operator           : Party        -- SignUIT operator
    routeId            : Text        -- Reference to original suggestion
    institution       : Party       -- Institution that authorized
    marginCallId      : Text        -- Associated margin call
    assetsSent        : [Text]       -- Assets delivered
    amountsSent      : [Decimal]    -- Amounts of each asset
    ruleApplied      : Text         -- Rule type used (CTD, ExpiryFirst, etc)
    opportunityCostBps : Decimal    -- Opportunity cost in basis points
    approvedBy       : Party       -- Who approved (institution)
    executedAt       : Time         -- Execution timestamp
    status           : RouteStatus  -- Executed or Failed
  where
    signatory institution
    observer operator  -- Operator records but does NOT gate

    -- Record failure
    choice MarkFailed : ContractId AllocationRecord
      controller institution
      do
        create this with status = RouteFailed