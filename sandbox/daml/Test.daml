module Test where

import Daml.Script
import Iou

test_iou : Script ()
test_iou = script do
  debug "TEST IOUs START"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  
  iouCid <- submit alice do
    createCmd Iou with
      issuer = alice
      owner = alice
      amount = 100.00
      currency = "USD"
      observers = [bob]
  
  debug "TEST IOUs END"
  return ()