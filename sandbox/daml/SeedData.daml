module SeedData where

import Daml.Script
import CollateralRouter
import DA.Time
import DA.Date

seed_demo_scenario : Script ()
seed_demo_scenario = script do
  debug "=== SignUIT CollateralRouter Demo Seed ==="
  
  -- 1. Allocate parties
  operator <- allocateParty "SignUIT"
  institution <- allocateParty "VantageCapital"
  counterparty <- allocateParty "PrimeBank"
  
  debug "Parties allocated"
  
  let now = time (date 2026 Apr 22) 14 30 0

  -- 2. Create CollateralPolicy (CTD rule)
  policyCid <- submitMulti [operator, institution] [] do
    createCmd CollateralPolicy with
      operator = operator
      institution = institution
      policyId = "CTD-POLICY-001"
      ruleType = CTD
      priorityList = ["USYC", "UST", "USDC"]
      minLtv = 0.95
      maxHaircut = 0.10
      counterpartyRules = [("PrimeBank", ["USYC", "UST", "USDC"])]
      autoApprove = False
      notificationEmail = Some "ops@vantage.capital"
      active = True
      createdAt = now
  
  debug "Policy created"
  
  -- 3. Create CollateralAssetMetadata
  submit operator do
    createCmd CollateralAssetMetadata with
      operator = operator
      assetSymbol = "USDC"
      currentYield = 0.0
      haircut = 0.0
      eligible = True
      updatedAt = now
  
  submit operator do
    createCmd CollateralAssetMetadata with
      operator = operator
      assetSymbol = "USYC"
      currentYield = 0.045  -- 4.5%
      haircut = 0.02        -- 2%
      eligible = True
      updatedAt = now
  
  submit operator do
    createCmd CollateralAssetMetadata with
      operator = operator
      assetSymbol = "UST"
      currentYield = 0.042  -- 4.2%
      haircut = 0.05        -- 5%
      eligible = True
      updatedAt = now
  
  debug "Asset metadata created"
  
  -- 4. Create CollateralHoldings
  submit institution do
    createCmd CollateralHolding with
      holdingId = "HOLD-USYC-001"
      institution = institution
      asset = "USYC"
      amount = 8200000.0  -- $8.2M
      yield = 0.045
      haircut = 0.02
      expiry = None
  
  submit institution do
    createCmd CollateralHolding with
      holdingId = "HOLD-UST-001"
      institution = institution
      asset = "UST"
      amount = 12000000.0  -- $12.0M
      yield = 0.042
      haircut = 0.05
      expiry = None
  
  submit institution do
    createCmd CollateralHolding with
      holdingId = "HOLD-USDC-001"
      institution = institution
      asset = "USDC"
      amount = 25000000.0  -- $25.0M
      yield = 0.0
      haircut = 0.0
      expiry = None
  
  debug "Holdings created"
  
  -- 5. Create MarginCall ($15M required)
  submit counterparty do
    createCmd MarginCall with
      callId = "MC-4821"
      institution = institution
      counterparty = counterparty
      amountRequired = 15000000.0
      currency = "USD"
      dueBy = time (date 2026 Apr 22) 16 0 0
      status = Pending
      createdAt = time (date 2026 Apr 22) 15 47 0
  
  debug "Margin call created"
  debug "=== Demo seed complete ==="
  
  return ()
