module CollateralRouterTest where

import Daml.Script
import CollateralRouter
import DA.Time
import DA.Date

test_collateral_routing : Script ()
test_collateral_routing = script do
  operator <- allocateParty "SignUIT"
  institution <- allocateParty "VantageCapital"
  counterparty <- allocateParty "PrimeBank"
  
  let now = time (date 2026 Apr 22) 14 30 0

  -- 1. Create CollateralAssetMetadata
  submit operator do
    createCmd CollateralAssetMetadata with
      operator = operator
      assetSymbol = "USYC"
      currentYield = 0.045
      haircut = 0.02
      eligible = True
      updatedAt = now

  -- 2. Create CollateralPolicy
  policyCid <- submitMulti [operator, institution] [] do
    createCmd CollateralPolicy with
      operator = operator
      institution = institution
      policyId = "CTD-POLICY-001"
      ruleType = CTD
      priorityList = ["USYC", "USDC"]
      minLtv = 0.95
      maxHaircut = 0.10
      counterpartyRules = [("PrimeBank", ["USYC", "USDC"])]
      autoApprove = False
      notificationEmail = Some "ops@vantage.capital"
      active = True
      createdAt = now

  -- 3. Create CollateralHolding (institution-only signatory, operator as observer)
  submit institution do
    createCmd CollateralHolding with
      operator = operator
      holdingId = "HOLD-USYC-001"
      institution = institution
      asset = "USYC"
      amount = 1000000.0
      yield = 0.045
      haircut = 0.02
      expiry = None

  -- 4. Trigger Margin Call
  marginCallCid <- submit counterparty do
    createCmd MarginCall with
      callId = "MC-001"
      operator = operator
      institution = institution
      counterparty = counterparty
      amountRequired = 500000.0
      currency = "USD"
      dueBy = time (date 2026 Apr 22) 17 0 0
      status = RoutePending
      createdAt = now

  -- 5. Create Routing Suggestion (institution-only)
  suggestionCid <- submit institution do
    createCmd RoutingSuggestion with
      routeId = "ROUTE-001"
      institution = institution
      operator = operator
      marginCallId = "MC-001"
      amountRequired = 500000.0
      suggestedAssets = ["USYC"]
      suggestedAmounts = [510204.08]
      estimatedOpportunityCost = 25.0
      opportunityCostBps = 15.0
      alternativeOptions = []
      expiryWarnings = []
      explanation = "Cheapest to deliver based on 4.5% yield"
      status = RoutePending
      createdAt = now

  -- 6. Approve Suggestion (institution-only decision)
  allocationCid <- submit institution do
    exerciseCmd suggestionCid ApproveSuggestion with approvedBy = institution

  -- 7. Satisfy Margin Call
  submit counterparty do
    exerciseCmd marginCallCid SatisfyMarginCall

  debug "Collateral routing test completed successfully"
  return ()