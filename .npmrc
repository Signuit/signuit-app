# Hoist all dependencies to avoid issues with optional dependencies  
# This is particularly needed for packages with native bindings like rolldown
shamefully-hoist=true

# Auto-install peers to avoid peer dependency issues
auto-install-peers=true

# Strict peer dependencies - set to false for more lenient installation
strict-peer-dependencies=false

# Ensure side effects are preserved during hoisting
side-effects-cache=true

# Allow these packages to run their post-install build scripts
# Required for native binaries to compile for the correct platform
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=msw
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@libsql/client
onlyBuiltDependencies[]=libsql
